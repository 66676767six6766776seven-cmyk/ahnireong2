{
  "rules": {
    ".read": false,
    "v2": {
      ".read": true,
      ".write": true,
      "donatedKrw": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 387000000000 && (!data.exists() || newData.val() >= data.val())"
      },
      "donatedInr": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 52400000000 && (!data.exists() || newData.val() >= data.val())"
      },
      "leg": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && (!data.exists() || newData.val() >= data.val())"
      },
      "trip": {
        ".validate": "newData.hasChildren(['leg', 'startAt'])",
        "leg": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "startAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      },
      "fever": {
        ".validate": "newData.hasChildren(['count', 'endAt'])",
        "count": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
        },
        "endAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
